---
import "@/styles/reset.css";
import "@/styles/global.css";
import Footer from "@/components/Footer.astro";
import Header from "@/components/header/Header.astro";
import { AVAILABLE_LANG, DEFAULT_LANG, useTranslations, useLocale, type Lang } from "~/i18n";
import ScrollTop from "@/components/ScrollTop.astro";
import BaseHead from "@/components/BaseHead.astro";
import SiteConfig, { SITE_URL_WITH_BASE } from "~/site.config";
import { ClientRouter } from "astro:transitions";
import LoadingIndicator from "astro-loading-indicator/component";
import type { ImageMetadata } from "astro";

type Props = {
  lang?: Lang;
  title?: string;
  description?: string;
  image?: string | ImageMetadata;
  canonicalURL?: string | null;
  alternates?: Map<Lang | "x-default", string> | null;
  noindex?: boolean;
  languageSwitchLinks?: Map<Lang, string>;
  type?: "article" | "website" | "profile";
  authors?: string[] | string;
  publishedTime?: string;
  modifiedTime?: string;
  username?: string;
  extraJsonLd?: Record<string, any>[] | Record<string, any>;
};

const currentLocale = useLocale() as Lang;

const {
  lang = currentLocale,
  title: headTitle,
  description: headDescription,
  image,
  canonicalURL,
  alternates,
  noindex = false,
  languageSwitchLinks,
  type = "website",
  authors,
  publishedTime,
  modifiedTime,
  username,
  extraJsonLd,
} = Astro.props;

const rawImage = image ?? SiteConfig.ogImage;
const imageSrc =
  typeof rawImage === "object" && rawImage !== null && "src" in rawImage ? rawImage.src : rawImage;

const ogImageUrl = imageSrc ? new URL(imageSrc, SiteConfig.siteUrl).href : undefined;

const t = useTranslations("common");

const siteTitle = t("site_title");
const siteDescription = t("site_description");

const title = headTitle ? `${headTitle} | ${siteTitle}` : siteTitle;
const description = headDescription ?? siteDescription;

// Self-referential canonical URL (Google SEO best practice)
const currentCanonical = canonicalURL ?? new URL(Astro.url.pathname, SiteConfig.siteUrl).href;

const alternateList: { language: Lang; href: string }[] = [];
let xDefaultURL: string | null = null;

// Build SEO hreflang tags for multilingual indexing (unless page is marked noindex)
if (!noindex) {
  if (typeof alternates === "undefined") {
    // Default: assume matching URLs exist across all languages
    AVAILABLE_LANG.forEach((language) => {
      const localizedPath = Astro.url.pathname.replace(
        new RegExp(`^${SiteConfig.basePath}/(${AVAILABLE_LANG.join("|")})`),
        `${SiteConfig.basePath}/${language}`,
      );
      alternateList.push({
        language,
        href: new URL(localizedPath, SiteConfig.siteUrl).href,
      });
    });
    const defaultPath = Astro.url.pathname.replace(
      new RegExp(`^${SiteConfig.basePath}/(${AVAILABLE_LANG.join("|")})`),
      `${SiteConfig.basePath}/${DEFAULT_LANG}`,
    );
    xDefaultURL = new URL(defaultPath, SiteConfig.siteUrl).href;
  } else if (alternates) {
    // Custom alternates map provided by page (e.g. blog posts with specific slugs per lang)
    alternates.forEach((href, language) => {
      if (language === "x-default") {
        xDefaultURL = href;
      } else {
        alternateList.push({ language, href });
      }
    });
    if (!xDefaultURL && currentCanonical) {
      xDefaultURL = currentCanonical;
    }
  }
}

// Language switch links for UI header dropdown (falls back to current path with language prefix swapped)
const switchLinks: Map<Lang, string> =
  languageSwitchLinks ??
  new Map(
    AVAILABLE_LANG.map((language) => [
      language,
      Astro.url.pathname.replace(`/${lang}`, `/${language}`),
    ]),
  );

// Locale mapping for OpenGraph
const ogLocales: Record<Lang, string> = {
  "zh-Hans": "zh_CN",
  "en-US": "en_US",
  "ja-JP": "ja_JP",
};
const currentOgLocale = ogLocales[lang] || "zh_CN";
const alternateOgLocales = AVAILABLE_LANG.filter((l) => l !== lang).map((l) => ogLocales[l]);

// Schema.org JSON-LD Structured Data
const jsonLdItems: Record<string, any>[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteTitle,
    url: SiteConfig.siteUrl,
    description: siteDescription,
    inLanguage: lang,
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: t("header_title"),
    url: SiteConfig.siteUrl,
    logo: new URL(SiteConfig.basePath + "/favicon.svg", SiteConfig.siteUrl).href,
  },
];

if (extraJsonLd) {
  if (Array.isArray(extraJsonLd)) {
    jsonLdItems.push(...extraJsonLd);
  } else {
    jsonLdItems.push(extraJsonLd);
  }
}

if (type === "article") {
  const authorName =
    typeof authors === "string"
      ? authors
      : Array.isArray(authors) && authors.length > 0
        ? authors[0]
        : t("header_title");

  jsonLdItems.push({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: headTitle || title,
    description: description,
    url: currentCanonical,
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": currentCanonical,
    },
    inLanguage: lang,
    datePublished: publishedTime,
    dateModified: modifiedTime || publishedTime,
    image: ogImageUrl ? [ogImageUrl] : undefined,
    author: {
      "@type": "Person",
      name: authorName,
    },
    publisher: {
      "@type": "Organization",
      name: t("header_title"),
      url: SiteConfig.siteUrl,
      logo: {
        "@type": "ImageObject",
        url: new URL(SiteConfig.basePath + "/favicon.svg", SiteConfig.siteUrl).href,
      },
    },
  });
}
---

<!doctype html>
<html
  lang={lang}
  data-code-theme-light={SiteConfig.codeTheme.light}
  data-code-theme-dark={SiteConfig.codeTheme.dark}
>
  <head>
    <BaseHead />
    <ClientRouter />
    <LoadingIndicator color="var(--primary)" height="0.25rem" />

    {
      (SiteConfig.googleSiteVerification || import.meta.env.GOOGLE_SITE_VERIFICATION) && (
        <meta
          name="google-site-verification"
          content={SiteConfig.googleSiteVerification || import.meta.env.GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    {
      (SiteConfig.bingSiteVerification || import.meta.env.BING_SITE_VERIFICATION) && (
        <meta
          name="msvalidate.01"
          content={SiteConfig.bingSiteVerification || import.meta.env.BING_SITE_VERIFICATION}
        />
      )
    }

    {
      (SiteConfig.baiduSiteVerification || import.meta.env.BAIDU_SITE_VERIFICATION) && (
        <meta
          name="baidu-site-verification"
          content={SiteConfig.baiduSiteVerification || import.meta.env.BAIDU_SITE_VERIFICATION}
        />
      )
    }

    {
      (SiteConfig.shenmaSiteVerification || import.meta.env.SHENMA_SITE_VERIFICATION) && (
        <meta
          name="shenma-site-verification"
          content={SiteConfig.shenmaSiteVerification || import.meta.env.SHENMA_SITE_VERIFICATION}
        />
      )
    }

    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }

    {/* Primary Meta Tags */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={currentCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={currentOgLocale} />
    {alternateOgLocales.map((loc) => <meta property="og:locale:alternate" content={loc} />)}
    <meta property="og:site_name" content={t("header_title")} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:alt" content={title} />}
    {
      publishedTime && type === "article" && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      modifiedTime && type === "article" && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }
    {
      type === "article" && typeof authors === "string" && (
        <meta property="article:author" content={authors} />
      )
    }
    {
      type === "article" &&
        Array.isArray(authors) &&
        authors.map((a) => <meta property="article:author" content={a} />)
    }
    {type === "profile" && username && <meta property="profile:username" content={username} />}

    {/* Twitter */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={currentCanonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    {ogImageUrl && <meta property="twitter:image" content={ogImageUrl} />}

    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS"
      href={`${SITE_URL_WITH_BASE}/${lang}/rss.xml`}
    />

    {/* Canonical URL */}
    {!noindex && currentCanonical && <link rel="canonical" href={currentCanonical} />}

    {/* Multilingual Hreflang Alternates */}
    {
      !noindex &&
        alternateList.map(({ language, href }) => (
          <link rel="alternate" href={href} hreflang={language} />
        ))
    }
    {!noindex && xDefaultURL && <link rel="alternate" href={xDefaultURL} hreflang="x-default" />}

    {/* Schema.org Structured Data (JSON-LD) */}
    {
      jsonLdItems.map((item) => (
        <script type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }
  </head>
  <body>
    <ScrollTop />
    <Header switchLinks={switchLinks} />
    <style>
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        min-height: 100dvh;
      }

      #container {
        margin-inline: auto;

        padding: var(--space-4);

        flex: 1;

        width: 100%;
        max-width: var(--content-max-width);
        box-sizing: border-box;
      }

      #container:focus {
        outline: none;
      }

      @media screen and (min-width: 1024px) {
        #container {
          padding-inline: var(--space-8);
        }
      }
    </style>
    <div class="fadeIn" id="container" transition:animate="none">
      <slot name="header" />
      <slot name="content" />
      <slot name="footer" />
    </div>
    <Footer />
  </body>
</html>
