# 网站部署根地址 (末尾不要带斜杠)
# Site deployment root URL (no trailing slash)
SITE_URL=https://jichangfree.cc

# 子路径部署前缀（根路径留空，无需末尾斜杠）
# Subpath deployment prefix (empty for root deployment)
BASE_PATH=

# Google 网站所有权验证代码（可选）
GOOGLE_SITE_VERIFICATION=

# Bing 网站所有权验证代码（msvalidate.01，可选）
BING_SITE_VERIFICATION=

# 百度搜索资源平台验证代码（baidu-site-verification，可选）
BAIDU_SITE_VERIFICATION=

# 神马站长平台验证代码（shenma-site-verification，可选）
SHENMA_SITE_VERIFICATION=
